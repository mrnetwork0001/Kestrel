# ==============================================================================
# Kestrel ($KEST) — Environment Configuration
# All core onchain reads (Base + Robinhood Chain + Vibestarter Escrow) work out
# of the box using public RPCs with ZERO API keys required.
# Copy to .env.local and fill in what you need.
# ==============================================================================

# --- Public RPC overrides (optional — defaults to official Mainnet RPCs) ---
NEXT_PUBLIC_BASE_RPC_URL="https://mainnet.base.org"
NEXT_PUBLIC_BASE_FALLBACK_RPC_URL="https://base-rpc.publicnode.com"
NEXT_PUBLIC_ROBINHOOD_RPC_URL="https://rpc.mainnet.chain.robinhood.com"

# --- Public app URL (set to your live Vercel URL before submission & Fundable check) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- WalletConnect / Reown project ID (optional — injected & Coinbase Smart Wallet work without it) ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

# --- Morning Desk Brief LLM (optional — deterministic onchain brief is used if none set) ---
# Priority 1: 0G Compute Router (OpenAI-compatible). Key from https://pc.0g.ai
ZG_COMPUTE_API_KEY=""
ZG_COMPUTE_BASE_URL="https://router-api.0g.ai/v1"
# Exact model ID as listed in the 0G console (e.g. an Anthropic or OpenAI model)
ZG_COMPUTE_MODEL=""

# Priority 2: Direct Anthropic API
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# --- x402 agent firewall (receives Base USDC micro-fees in /api/v1/guard) ---
X402_RECEIVER_ADDRESS=""
X402_PRICE_USDC_ATOMIC="10000" # 0.01 USDC (6 decimals)
# Optional x402 facilitator for settlement (verify-only if unset)
X402_FACILITATOR_URL=""

# --- Night-Shift Pager (optional Telegram; webhooks work without it) ---
TELEGRAM_BOT_TOKEN=""
