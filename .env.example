# ==============================================================================
# Kestrel ($KEST) — Environment Configuration
# Every variable below is OPTIONAL. All core onchain reads (Base + Robinhood
# Chain + Vibestarter escrows) work out of the box on public RPCs, no API keys.
#   cp .env.example .env.local   (never commit .env.local)
# ==============================================================================

# --- Public RPC overrides (optional — defaults to official Mainnet RPCs) ---
NEXT_PUBLIC_BASE_RPC_URL="https://mainnet.base.org"
NEXT_PUBLIC_BASE_FALLBACK_RPC_URL="https://base-rpc.publicnode.com"
NEXT_PUBLIC_ROBINHOOD_RPC_URL="https://rpc.mainnet.chain.robinhood.com"

# --- Canonical public URL (sitemap, robots, OpenAPI servers, agent snippets, pager deep links) ---
# Leave empty on Vercel: it falls back to VERCEL_PROJECT_PRODUCTION_URL, then VERCEL_URL, then the
# request origin, then http://localhost:3002. localhost values here are ignored. Set it for a custom domain.
NEXT_PUBLIC_APP_URL=""

# --- WalletConnect / Reown project ID (optional — injected & Coinbase Smart Wallet work without it) ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

# --- Morning Desk Brief LLM (optional — deterministic onchain brief is used if none set) ---
# Priority 1: 0G Compute Router (OpenAI-compatible). Key from https://pc.0g.ai
ZG_COMPUTE_API_KEY=""
ZG_COMPUTE_BASE_URL="https://router-api.0g.ai/v1"
# Exact model ID as listed in the 0G console (e.g. an Anthropic or OpenAI model)
ZG_COMPUTE_MODEL=""

# Priority 2: Direct Anthropic API
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# --- x402 agent firewall (receives Base USDC micro-fees in /api/v1/guard) ---
X402_RECEIVER_ADDRESS=""
X402_PRICE_USDC_ATOMIC="10000" # 0.01 USDC (6 decimals)
# Optional x402 facilitator for settlement (verify-only if unset)
X402_FACILITATOR_URL=""

# --- Night-Shift Pager (optional Telegram; webhooks work without it) ---
TELEGRAM_BOT_TOKEN=""
# Shared secret for the scheduled pager tick (Vercel Cron sends "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=""

# --- Shared state on serverless: rate limits, response cache, pager watches, x402 nonces ---
# Upstash Redis REST. Vercel Marketplace (Upstash) integration injects the KV_* names automatically;
# UPSTASH_REDIS_REST_* from the Upstash console works too. Unset = per-process in-memory store (fine for local dev).
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# --- GitHub API token (optional; raises the 60 req/h anonymous limit for founder repo velocity) ---
GITHUB_TOKEN=""
