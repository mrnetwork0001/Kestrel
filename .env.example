# ==============================================================================
# Kestrel: environment configuration (every variable the code reads; placeholders only)
#   cp .env.example .env.local   (never commit .env.local; never paste keys into issues or logs)
#
# Local dev needs NOTHING: every onchain read (Base 8453, Robinhood Chain 4663, Vibestarter escrows,
# $VIBES OFT parity) works on public RPCs with no API keys, and state lives in process memory.
#
# Legend:
#   [PROD-REQUIRED]    set on any public deployment, or the named feature is disabled / unsafe
#   [PROD-RECOMMENDED] works without it, but degraded (rate-limited public RPCs, missing links, ...)
#   [OPTIONAL]         feature switch or tuning knob; the default shown is what the code uses when unset
# Lines starting with "# NAME=" are documented defaults: uncomment only to change them.
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. Site URL
# ------------------------------------------------------------------------------
# [PROD-RECOMMENDED] Canonical public origin: sitemap, robots, canonicals, OpenAPI `servers`, /agents snippets,
# pager deep links and Telegram / Discord / Slack buttons, MCP Origin allow-list. On Vercel it falls back to
# VERCEL_PROJECT_PRODUCTION_URL, then VERCEL_URL (both set by Vercel automatically), then the request origin,
# then http://localhost:3002. localhost values are ignored. REQUIRED for a custom domain.
NEXT_PUBLIC_APP_URL=""


# ------------------------------------------------------------------------------
# 2. RPC endpoints
# ------------------------------------------------------------------------------
# --- 2a. SERVER-ONLY (never sent to browsers): the home for KEYED endpoints -------------------------------------
# Scans, the guard, MCP, the pager and SSR read through these (src/lib/rpc.ts), in order, then fall back to the
# public RPCs below. Comma-separated lists are accepted (*_URLS). Values are treated as secrets: hosts only are ever
# logged or shown (diagnostics redact paths/keys).
# [PROD-RECOMMENDED] Base Mainnet read RPC(s), e.g. a keyed Alchemy / QuickNode / Coinbase CDP URL.
# BASE_RPC_URL=""
# BASE_RPC_URLS=""
# [PROD-RECOMMENDED] Robinhood Chain Mainnet read RPC(s). The first one is also the server log provider.
# Server requests always send "User-Agent: Kestrel-Sentinel/1.0 (+https://vibestarter.xyz)" (Cloudflare WAF 403s bot UAs).
# ROBINHOOD_RPC_URL=""
# ROBINHOOD_RPC_URLS=""
# [OPTIONAL] Indexed Base RPC used ONLY for eth_getLogs (mainnet.base.org refuses getLogs; default is publicnode:
# <=50k blocks, <=10 addresses, <=20k results per query). When set, approval / Transfer log searches run across ALL
# tokens (topic-only filters) instead of the curated list.
# BASE_LOGS_RPC_URL=""
# [OPTIONAL] Max block range per eth_getLogs call on BASE_LOGS_RPC_URL (default 10000).
# BASE_LOGS_MAX_RANGE="10000"

# --- 2b. BROWSER-VISIBLE (NEXT_PUBLIC_*): wallet reads in the user's browser (wagmi, Panic Bunker) ---------------
# WARNING: NEXT_PUBLIC_* values are inlined into every client JS bundle. Anyone can read them. Put ONLY public or
# domain-restricted endpoints here, NEVER a keyed URL (scrapers would burn its quota). The server does not read them.
NEXT_PUBLIC_BASE_RPC_URL="https://mainnet.base.org"
NEXT_PUBLIC_BASE_FALLBACK_RPC_URL="https://base-rpc.publicnode.com"
NEXT_PUBLIC_ROBINHOOD_RPC_URL="https://rpc.mainnet.chain.robinhood.com"


# ------------------------------------------------------------------------------
# 3. Shared state: Upstash Redis (rate limits, response cache, pager desks/watches/log, x402 replay ledger)
# ------------------------------------------------------------------------------
# [PROD-REQUIRED] Without it, production pager routes answer 503 ("Pager storage not configured"), ticks skip with
# "no-storage", and the x402 paid tier refuses payments (no replay protection). Unset locally = in-memory store.
# The Vercel Marketplace (Upstash) integration injects KV_*; UPSTASH_REDIS_REST_* from the Upstash console works too.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
# [OPTIONAL, dev only] In `next dev` with the memory store, pager data is snapshotted to .next/cache/kestrel-dev-kv.json
# so desks survive dev-server restarts (never with Upstash or in production). "0" disables the snapshot.
# KV_DEV_SNAPSHOT="1"


# ------------------------------------------------------------------------------
# 4. Night-Shift Pager
# ------------------------------------------------------------------------------
# [PROD-REQUIRED for 24/7 watching] Scheduler auth for GET|POST /api/pager/tick. Set CRON_SECRET (sent as
# "Authorization: Bearer $CRON_SECRET" by Vercel Cron / cron-job.org, e.g. /api/pager/tick?async=1 every 4 min)
# and/or the QStash signing keys. Production uses an Upstash QStash schedule POST /api/pager/tick on "*/4 * * * *"
# with retries 0 (360 messages/day, inside the 500/day free tier). Without any, production only gets opportunistic ticks from /api/pager/status
# visits; locally the in-process scheduler runs and unauthenticated ticks are allowed from localhost under next dev.
CRON_SECRET=""
# QSTASH_CURRENT_SIGNING_KEY=""
# QSTASH_NEXT_SIGNING_KEY=""

# [OPTIONAL] Telegram delivery (webhooks to Discord / Slack / any https URL work without it).
TELEGRAM_BOT_TOKEN=""
# Bot username for t.me deep links (otherwise looked up once via getMe).
# TELEGRAM_BOT_USERNAME=""
# Set to switch from getUpdates polling to webhook mode; then run Telegram setWebhook with
# url=<site>/api/pager/telegram/webhook and secret_token=<this value>.
# TELEGRAM_WEBHOOK_SECRET=""

# [OPTIONAL] Pager limits and tuning (defaults shown).
# PAGER_MAX_WATCHES_PER_DESK="10"
# PAGER_MAX_WATCHES_TOTAL="500"
# Share of the total available to desks WITHOUT a verified Telegram chat or webhook (default 60% of the total).
# PAGER_MAX_CHANNELLESS_WATCHES="300"
# Per network per UTC day (IPv6 clients are bucketed by /64).
# PAGER_MAX_DESKS_PER_IP_DAY="20"
# Global cap on desks across all networks.
# PAGER_MAX_DESKS_TOTAL="5000"
# Expected scheduler cadence in seconds (health check: a tick older than 3x cadence = stale). Default 240 = every 4 min.
# PAGER_CADENCE_SEC="240"
# Time budget for one tick in ms (5000-280000). The tick lock lives budget + 30 s, so ticks never overlap.
# PAGER_TICK_BUDGET_MS="40000"
# Threat-band rescans per tick (0-10).
# PAGER_SCANS_PER_TICK="2"
# In-process scheduler for `next dev` / self-hosted Node (never runs on Vercel). "0" disables it.
# PAGER_INPROCESS="1"
# PAGER_INPROCESS_INTERVAL_SEC="60"
# Extra salt for the daily-rotating per-IP hash used by desk-creation caps.
# PAGER_IP_SALT=""
# Desk id whose watches are shown (labels and status only) in the public Night-Shift Log (/api/pager/status).
# PAGER_SYSTEM_DESK_ID=""


# ------------------------------------------------------------------------------
# 5. x402 paid tier for /api/v1/guard?mode=full (x402 v2 PAYMENT-SIGNATURE + v1 X-PAYMENT, Base USDC "exact")
# ------------------------------------------------------------------------------
# [PROD-REQUIRED for the paid tier] Base address that receives USDC. Unset = mode=full answers 501 and
# /api/x402/revenue reports configured:false (the free preview tier always works). Use a fresh dedicated address.
X402_RECEIVER_ADDRESS=""
# [OPTIONAL] Price per paid call in atomic USDC (6 decimals): 10000 = 0.01 USDC.
X402_PRICE_USDC_ATOMIC="10000"
# [OPTIONAL] Payment authorization validity window in seconds (60-3600, default 300).
# X402_MAX_TIMEOUT_SECONDS="300"
# [OPTIONAL] Facilitator: auto (default: CDP when CDP keys are set, else PayAI keyless) | cdp | payai | custom
# X402_FACILITATOR="auto"
# Used only when X402_FACILITATOR=custom (an x402 facilitator base URL exposing /verify and /settle).
# X402_FACILITATOR_URL=""
# CDP Secret API Key (Coinbase Developer Platform) for the CDP facilitator and Bazaar listing.
# Write PEM line breaks as \n. Server-only; never expose.
# CDP_API_KEY_ID=""
# CDP_API_KEY_SECRET=""
# Optional PayAI API key (only needed after PayAI's free tier is exhausted).
# PAYAI_API_KEY_ID=""
# PAYAI_API_KEY_SECRET=""
# [PROD-RECOMMENDED with a receiver] Base block where the /api/x402/revenue onchain scan starts
# (set it to the block when the receiver was created; unset = ~24 h before the first scan, labelled auto-24h).
# X402_LEDGER_FROM_BLOCK=""
# Escape hatch: "1" allows the paid tier in production WITHOUT Upstash (no cross-instance replay ledger). Not recommended.
# X402_ALLOW_MEMORY_LEDGER=""


# ------------------------------------------------------------------------------
# 6. Morning Desk Brief LLM (optional; without one a deterministic brief is built from the same live facts)
# ------------------------------------------------------------------------------
# Priority 1: 0G Compute Router (OpenAI-compatible). Key from https://pc.0g.ai. Both KEY and MODEL are needed.
ZG_COMPUTE_API_KEY=""
# Exact model id as listed in the 0G console (production uses claude-sonnet-5.5).
ZG_COMPUTE_MODEL=""
# ZG_COMPUTE_BASE_URL="https://router-api.0g.ai/v1"
# Priority 2: Anthropic API.
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-opus-5-5"
# [OPTIONAL] LLM calls per UTC day across every LLM use (POST /api/brief + pager digests), shared via KV.
# Default 300; "0" disables the LLM entirely. LLM_DAILY_CAP is accepted as an alias.
# BRIEF_LLM_DAILY_CAP="300"


# ------------------------------------------------------------------------------
# 7. Third-party data sources
# ------------------------------------------------------------------------------
# [PROD-RECOMMENDED] GitHub token (no scopes needed) for founder repo velocity on Backer Shield / Ecosystem.
# Anonymous GitHub allows 60 requests/hour per IP, which a single board rebuild can exhaust.
GITHUB_TOKEN=""
# [OPTIONAL] Vibestarter MCP server consumed for Vibestarter Pulse and the launch universe.
# VIBESTARTER_MCP_URL="https://app.vibestarter.xyz/mcp"
# (Vibestarter's REST API base https://app.vibestarter.xyz/api is fixed in code; there is no VIBESTARTER_API_BASE.)

# [OPTIONAL] WalletConnect / Reown project id (injected wallets and Coinbase Smart Wallet work without it).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""


# ------------------------------------------------------------------------------
# 8. Build and hosting
# ------------------------------------------------------------------------------
# [OPTIONAL] Output dir for `next build` so it can run while `next dev` keeps using .next (default ".next").
# NEXT_DIST_DIR=".next"
# [VERCEL PROJECT SETTING, not read by the code] Set VERCEL_FORCE_NO_BUILD_CACHE=1 in the Vercel project: a stale
# build cache once broke git-triggered deploys.
# VERCEL_FORCE_NO_BUILD_CACHE="1"


# ------------------------------------------------------------------------------
# Set by the platform, do not set by hand: VERCEL, VERCEL_ENV, VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL,
# NODE_ENV, NEXT_RUNTIME, NEXT_PHASE.
# ------------------------------------------------------------------------------
